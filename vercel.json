{
  "version": 2,
  "framework": null,
  "regions": ["bom1"],
  "builds": [
    { "src": "backend/public/ops/**", "use": "@vercel/static" },
    { "src": "backend/src/app.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/ops-assets/(.*)", "dest": "/backend/public/ops/$1" },
    { "src": "/", "dest": "/backend/public/ops/ops.html" },
    { "src": "/console", "dest": "/backend/public/ops/ops.html" },
    { "src": "/health", "dest": "/backend/src/app.js" },
    { "src": "/api/(.*)", "dest": "/backend/src/app.js" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}