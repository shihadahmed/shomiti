{
  "version": 2,
  "framework": null,
  "regions": ["bom1"],
  "builds": [
    { 
      "src": "backend/src/app.js", 
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["public/ops/**"]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/src/app.js" },
    { "src": "/(.*)", "dest": "/backend/src/app.js" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}