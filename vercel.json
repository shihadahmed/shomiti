{
  "version": 2,
  "framework": null,
  "regions": ["bom1"],
  "builds": [
    { "src": "backend/src/app.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/src/app.js" }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "backend/src/app.js": {
      "maxDuration": 30
    }
  }
}