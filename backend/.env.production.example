# Shomiti Backend - PRODUCTION Environment Variables
# ============================================
# DO NOT USE .env FILE IN PRODUCTION!
# Set these as SYSTEM ENVIRONMENT VARIABLES on your server:
# - systemd: Environment=KEY=value in service file
# - Docker: -e KEY=value or --env-file (separate file, not committed)
# - PM2: env_production in ecosystem.config.js
# - Vercel/AWS/Heroku: Dashboard > Environment Variables
# ============================================

# REQUIRED - Must be set in production
NODE_ENV=production
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/shomiti?retryWrites=true&w=majority
JWT_SECRET=your-64-char-hex-secret-from-crypto-randomBytes

# OPTIONAL - Override defaults if needed
# PORT=4000
# JWT_EXPIRES_IN=8h
# COOKIE_NAME=sn_token
# COOKIE_MAX_AGE_MS=28800000
# CLIENT_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
# UPLOAD_DIR=uploads
# MAX_UPLOAD_BYTES=5242880
# APPROVAL_THRESHOLD_TAKA=10000
# BCRYPT_ROUNDS=12
# SERVE_FRONTEND=true

# SEED ADMIN - Only needed on first deploy
# SEED_ADMIN_NAME=System Administrator
# SEED_ADMIN_EMAIL=admin@yourdomain.com
# SEED_ADMIN_PHONE=01700000000
# SEED_ADMIN_PASSWORD=StrongProductionPassword123!