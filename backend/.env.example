# Shomiti Backend Configuration
# Copy this file to .env and fill in your values

# ============================================
# MONGODB ATLAS - Your cloud connection string
# Get this from MongoDB Atlas > Clusters > Connect > Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# ============================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/shomiti?retryWrites=true&w=majority
# mongodb+srv://shihadbinahmed_db_user:A5BgrLRanverMCd3@cluster0.onaaqwh.mongodb.net/

# ============================================
# JWT - Must be a strong random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=8h
COOKIE_NAME=sn_token
COOKIE_MAX_AGE_MS=28800000

# ============================================
# Server
# ============================================
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# ============================================
# File Uploads
# ============================================
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# ============================================
# Approval Threshold (in Taka)
# Amounts above this require multi-level approval
# ============================================
APPROVAL_THRESHOLD_TAKA=10000

# ============================================
# Password Hashing
# ============================================
BCRYPT_ROUNDS=12

# ============================================
# Seed Admin (first run only)
# ============================================
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@shomiti.local
SEED_ADMIN_PHONE=01700000000
SEED_ADMIN_PASSWORD=Admin@12345

# ============================================
# Serve Frontend from Backend (production)
# ============================================
SERVE_FRONTEND=true