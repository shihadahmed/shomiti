# Frontend
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/build/
/frontend/dist/
/frontend/.env*.local
/frontend/.env
/frontend/.vercel

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Testing
coverage/
.nyc_output/